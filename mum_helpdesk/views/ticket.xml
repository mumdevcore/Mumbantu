<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.tree</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position='after'>
                <field name="category_id" />
            </field>
            <field name='tag_ids' position='attributes'>
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">

           
            <field name='team_id' position='before'>
                <!-- <field name="user_create_id" /> -->
                <field name="category_id" position='move'/>
                <field name="readonly" invisible='1' />
            </field>

            <field name='user_ids' position='attributes'>
                <attribute name='invisible'>False</attribute>
                <attribute name='widget'>many2many_tags</attribute>
            </field>


            <field name='sequence' position='after'>
                <field name="perihal" required='1' attrs="{'readonly' : [('readonly', '=', True)]}"/>
                <field name="description" position='move'/>
                <field name="helpdesk_attachment_ids" widget='many2many_attachment_preview' attrs="{'readonly' : [('readonly', '=', True)], 'invisible' : [('has_attachment', '=', False)]}" />
                <div class="row">
                    <div class="col-3">
                        <field name="has_attachment" invisible='1' />
                        <field name="add_attachment" invisible='1' />
                        
                        <button string="Add Attachment" name="button_add_attachment" type="object" class="oe_highlight" attrs="{'invisible' : [('has_attachment', '=', True)]}"/>
                    </div>
                </div>
                <field name="stage_sequence" invisible='1' />
                <field name="team_user" invisible='1' />
                <!-- Tombol untuk User yang membuat -->
                <div class="row" colspan='2' attrs="{'invisible' : ['|', ('stage_sequence', 'not in', (200)), ('team_user', '=', True)]}">
                    <div class="col-2">
                        <button string="Confirm" name="button_confirm" type="object" class="btn-primary"/>
                    </div>
                </div>
                <div class="row" colspan='2' attrs="{'invisible' : ['|', ('stage_sequence', 'not in', (1,2,3)), ('team_user', '=', False)]}">
                    <div class="col-3"/>
                    <div class="col-2">
                        <button string="Selesai" name="button_selesai" type="object" class="btn-success"/>
                    </div>
                    <div class="col-2">
                        <button string="Revisi" name="button_revisi" type="object" class="btn-warning"/>
                    </div>

                    <div class="col-2">
                        <button string="Ditolak" name="button_reject" type="object" class="btn-danger"/>
                    </div>
                    <div class="col-3"/>
                </div>
                <field name="catatan_tim" attrs="{
                    'invisible' : ['|', ('stage_sequence', 'not in', (1,2,3,100,200,999)), ('team_user', '=', False)],
                    
                    }" />
            </field>

            <field name='stage_id' position='attributes'>
                <attribute name='attrs'>{'readonly' : [('team_user', '=', False)]}</attribute>
            </field>

            <field name="description" position='attributes'>
                <attribute name='widget'/>
                <attribute name='required'>True</attribute>
                <attribute name='attrs'>{'readonly' : [('readonly', '=', True)]}</attribute>
            </field>

            <!-- Readonly Condition Fields -->

            <field name='name' position='attributes'>
                <attribute name='attrs'>{'readonly' : [('readonly', '=', True)]}</attribute>
            </field>

            <field name='category_id' position='attributes'>
                <attribute name='required'>1</attribute>
                <attribute name='attrs'>{'readonly' : [('readonly', '=', True)],}</attribute>
            </field>

            <field name='team_id' position='attributes'>
                <attribute name='required'>1</attribute>
                <attribute name='attrs'>{'readonly' : [('readonly', '=', True)]}</attribute>
            </field>
            
            <field name='user_id' position='attributes'>
                <attribute name='required'>1</attribute>
                <attribute name='attrs'>{'readonly' : [('readonly', '=', True)]}</attribute>
            </field>

            <field name='priority' position='attributes'>
                <attribute name='attrs'>{'readonly' : [('readonly', '=', True)]}</attribute>
            </field>

            <field name='company_id' position='attributes'>
                <attribute name='attrs'>{'readonly' : [('readonly', '=', True)]}</attribute>
            </field>

            <field name='priority' position='attributes'>
                <attribute name='attrs'>{'readonly' : [('readonly', '=', True)]}</attribute>
            </field>
            
            
            
            <!-- Invisible Fields -->
            <field name='sequence' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>
            
            <xpath expr="//page[@name='description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- <field name='product_id' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field> -->

            <field name='channel_id' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

            <field name='partner_id' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

            <field name='partner_name' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

            <field name='partner_email' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

            <field name='tag_ids' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

        </field>
    </record>

</odoo>
