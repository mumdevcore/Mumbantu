<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <field name='team_id' position='before'>
                <!-- <field name="user_create_id" /> -->
                <field name="category_id" position='move'/>
                <field name="readonly" />
            </field>

            <field name='user_ids' position='attributes'>
                <attribute name='invisible'>False</attribute>
                <attribute name='widget'>many2many_tags</attribute>
            </field>

            <field name='sequence' position='after'>
                <field name="perihal" required='1' />
                <field name="description" position='move' />
                <field name="helpdesk_attachment_ids" widget='many2many_attachment_preview' />
                <field name="stage_sequence" invisible='1' />
                <field name="team_user" invisible='1' />
                <div class="row" colspan='2' attrs="{'invisible' : ['|', ('stage_sequence', 'not in', (2,3,200)), ('team_user', '=', False)]}">
                    <div class="col-3"/>
                    <div class="col-2">
                        <button string="Selesai" name="button_selesai" type="object" class="btn-success"/>
                    </div>
                    <div class="col-2">
                        <button string="Revisi" name="button_revisi" type="object" class="btn-warning"/>
                    </div>

                    <div class="col-2">
                        <button string="Ditolak" name="button_reject" type="object" class="btn-danger"/>
                    </div>
                    <div class="col-3"/>
                </div>
                <field name="catatan_tim" attrs="{'invisible' : ['|', ('stage_sequence', 'not in', (2,3,100,200,999)), ('team_user', '=', False)]}" />
            </field>

            <xpath expr="//page[@name='description']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <field name='channel_id' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

            <field name='partner_id' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

            <field name='partner_name' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

            <field name='partner_email' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

            <field name='tag_ids' position='attributes'>
                <attribute name='invisible'>1</attribute>
            </field>

        </field>
    </record>

</odoo>
