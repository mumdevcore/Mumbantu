<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_ticket_category_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.category.view.tree</field>
        <field name="model">helpdesk.ticket.category</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_category_tree"/>
        <field name="arch" type="xml">
            <field name='name' position='after'>
                <field name="team_id" />
                <field name="filtered_user_ids" invisible='1' widget='many2many_tags' />
                <field name="user_ids" domain="[('id', 'in', filtered_user_ids)]" widget='many2many_tags'/>
            </field>
        </field>
    </record>

</odoo>
