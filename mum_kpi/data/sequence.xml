<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="employee_kpi_batch_seq" model='ir.sequence'>
        <field name='name'>Employee KPI Sequence</field>
        <field name="code">employee.kpi.batch.seq</field>
        <field name='suffix'>/%(range_month)s/%(range_year)s/MUM-KPI-RO</field>
        <field name='padding'>3</field>
        <field eval="1" name="number_next"/>
        <field eval="1" name="number_increment"/>
        <field name='use_date_range' eval='True'/>
        <field name='range_reset'>monthly</field>
    </record>

</odoo>
