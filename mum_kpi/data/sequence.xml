<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kpi_mekaar_batch_sequence" model='ir.sequence'>
        <field name='name'>KPI Mekaar Batch Sequence</field>
        <field name="code">kpi.mekaar.batch.seq</field>
        <field name='suffix'>/%(range_year)s/MUM-KPI-MEKAAR</field>
        <field name='padding'>3</field>
        <field eval="1" name="number_next"/>
        <field eval="1" name="number_increment"/>
        <field name='use_date_range' eval='True'/>
        <field name='range_reset'>yearly</field>
    </record>

    <record id="employee_kro_kpi_seq" model='ir.sequence'>
        <field name='name'>KRO KPI Sequence</field>
        <field name="code">employee.kro.kpi.seq</field>
        <field name='suffix'>/%(range_year)s/MUM-KPI-KRO</field>
        <field name='padding'>5</field>
        <field eval="1" name="number_next"/>
        <field eval="1" name="number_increment"/>
        <field name='use_date_range' eval='True'/>
        <field name='range_reset'>yearly</field>
    </record>

    <record id="employee_portofolio_kpi_seq" model='ir.sequence'>
        <field name='name'>Portofolio KPI Sequence</field>
        <field name="code">employee.portofolio.kpi.seq</field>
        <field name='suffix'>/%(range_year)s/MUM-KPI-PORTOFOLIO</field>
        <field name='padding'>3</field>
        <field eval="1" name="number_next"/>
        <field eval="1" name="number_increment"/>
        <field name='use_date_range' eval='True'/>
        <field name='range_reset'>yearly</field>
    </record>

