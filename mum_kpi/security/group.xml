<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="category_insentif_karyawan" model="ir.module.category">
	        <field name="name">KPI</field>
	    </record>

		<record id="group_insentif_user" model="res.groups">
			<field name="name">KPI User</field>
	        <field name="category_id" ref="category_insentif_karyawan" />
			<field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
		</record>

		<record id="group_insentif_manager" model="res.groups">
			<field name="name">KPI Administrator</field>
	        <field name="category_id" ref="category_insentif_karyawan" />
			<field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
	        <field name="implied_ids" eval="[(4, ref('group_insentif_user'))]" />
		</record>
    </data>
</odoo>