<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kpi_user_role" model="ir.rule">
        <field name="name">KPI Batch User Role</field>
        <field name="model_id" ref="mum_kpi.model_employee_kpi_batch"/>
        <field name="domain_force">['|', ('kro_id','=', user.employee_id.id), ('user_approval_1','=', user.id)]</field>
        <field eval="1" name="perm_unlink" />
        <field eval="1" name="perm_write" />
        <field eval="1" name="perm_read" />
        <field eval="1" name="perm_create" />
        <field name="groups" eval="[(4, ref('mum_kpi.group_insentif_user'))]"/>
    </record>

    <record id="kpi_manager_role" model="ir.rule">
        <field name="name">KPI Batch Admin Role</field>
        <field name="model_id" ref="mum_kpi.model_employee_kpi_batch"/>
        <field name="domain_force">[(1,'=', 1)]</field>
        <field eval="1" name="perm_unlink" />
        <field eval="1" name="perm_write" />
        <field eval="1" name="perm_read" />
        <field eval="1" name="perm_create" />
        <field name="groups" eval="[(4, ref('mum_kpi.group_insentif_manager'))]"/>
    </record>
    User
</odoo>
