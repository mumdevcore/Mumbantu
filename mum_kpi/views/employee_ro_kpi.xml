<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="employee_kpi_view_tree" model="ir.ui.view">
        <field name="name">employee.ro.kpi.view.tree</field>
        <field name="model">employee.ro.kpi</field>
        <field name="arch" type="xml">
            <tree create='0' delete='0'>
                <field name="employee_id" readonly='1' />
                <field name="absen" />
                <field name="tidak_masuk" />
                <field name="more" />
                <field name="total_resign" invisible='1'/>
                <field name="total_rekrutmen" />
                <field name="total_tl" />
                <field name="average" widget='percentage' groups='mum_kpi.group_insentif_manager' />
                <field name="grade_average_id" groups='mum_kpi.group_insentif_manager' />
                <field name="company_id" invisible='1' />
                <field name="insentif_maintain" invisible='1'/>
                <field name="insentif_rekrutmen" invisible='1'/>
                <field name="insentif_tl" invisible='1'/>
                <field name="insentif_wilayah_suffer" invisible='1'/>
                
                <field name="wilayah_suffer_id" groups='mum_kpi.group_insentif_manager' />
                <field name="total_insentif" invisible='1'/>
                <field name="employee_monthly_kpi_line" invisible='1' />
            </tree>
        </field>
    </record>

    <record id="employee_kpi_view_form" model="ir.ui.view">
        <field name="name">employee.ro.kpikpi.view.form</field>
        <field name="model">employee.ro.kpi</field>
        <field name="arch" type="xml">
            <form create='0' delete='0'>
                <sheet>
                    <group string="Total">
                        <group>
                            <field name="total_resign" invisible='1' />
                            <field name="total_rekrutmen" />
                            <field name="total_tl" />
                            
                            <field name="employee_id" invisible='1' />
                            <field name="company_id" invisible='1' />
                            <field name="state" invisible='1' />
                            
                        </group>
                        
                        <group>
                            <!-- <field name="avg_maintain_pertama" widget='percentage'  attrs="{'readonly' : [('state', 'in', ('draft', 'done', 'cancel'))]}" /> -->
                            <field name="average" widget='percentage' groups='mum_kpi.group_insentif_manager' />
                            <field name="grade_average_id" groups='mum_kpi.group_insentif_manager'/>
                        </group>
                    </group>
                    <group string="Insentif RO" groups='mum_kpi.group_insentif_manager' attrs="{'invisible' : [('state', 'not in', ('approval_1', 'approval_2', 'done'))]}">
                        <group>
                            <field name="wilayah_suffer_id" attrs="{'readonly' : [('state', 'in', ('draft', 'done', 'cancel'))]}"/>
                            <field name="insentif_wilayah_suffer" />
                            <field name="potongan_absen" />
                            <field name="insentif_more" />
                        </group>
                        <group>
                            <field name="insentif_maintain" />
                            <field name="insentif_rekrutmen" />
                            <field name="insentif_tl" />
                            <field name="total_insentif" />
                        </group>
                    </group>

                    <group string="Penyesuaian Insentif" groups='mum_kpi.group_insentif_manager' attrs="{'invisible' : [('state', 'not in', ('approval_1', 'approval_2', 'done'))]}">
                        <group>
                            <field name="alasan_penyesuaian" attrs="{'readonly' : [('state', 'in', ('draft', 'in_progress', 'done', 'cancel'))]}"/>
                        </group>
                        <group>
                            <field name="penyesuaian" attrs="{'readonly' : [('state', 'in', ('draft', 'in_progress', 'done', 'cancel'))]}"/>
                        </group>
                    </group>
                    
                    <separator string="KPI Bulanan"/>
                    <field name="employee_monthly_kpi_line" attrs="{'readonly' : [('state', 'in', ('draft', 'approval_2', 'done', 'cancel'))]}">
                        <tree editable='bottom' delete='0' create='0'>
                            <field name="sequence" invisible='1' />
                            <field name="name" />                                
                            <field name="employee_kro_kpi_id" invisible='1' />
                            <field name="month_id" invisible='1'/>
                            <field name="absen" />
                            <field name="tidak_masuk" />
                            <field name="grade_absen_id" invisible='1' />
                            <field name="more" />
                            <field name="grade_more_id" invisible='1' />
                            <field name="cabang" />
                            <field name="formasi" />
                            <field name="aktif" />
                            <field name="resign" invisible='1' />
                            <field name="rekrutmen" />
                            <field name="tl" />
                            <field name="kurang" />

                            <field name="grade_absen_id" invisible='1' />
                            <field name="potongan_absen" invisible='1' />
                            <field name="grade_more_id" invisible='1' />
                            <field name="insentif_more" invisible='1' />
                            <field name="pencapaian_rekrutmen" widget='percentage' invisible='1' />
                            <field name="grade_rekrutmen_id" invisible='1' />
                            <field name="pencapaian_maintain" widget='percentage' invisible='1' />
                            <field name="grade_maintain_id" invisible='1' />
                            <field name="pencapaian_tl" widget='percentage' invisible='1' />
                            <field name="grade_tl_id" invisible='1' />
                            <field name="insentif_maintain" invisible='1' />
                            <field name="insentif_rekrutmen" invisible='1' />
                            <field name="insentif_tl" invisible='1' />
                            <field name="pemenuhan" widget='percentage' />
                            
                            <field name="company_id" invisible='1' />
                        </tree>
                    </field>

                    <separator string="Hasil KPI Bulanan" groups='mum_kpi.group_insentif_manager'/>
                    <field name="employee_monthly_kpi_result_line" readonly='1' groups='mum_kpi.group_insentif_manager'>
                        <tree editable='bottom' delete='0' create='0'>
                            <field name="sequence" invisible='1' />
                            <field name="name" />
                            <field name="grade_absen_id" />
                            <field name="potongan_absen" />
                            <field name="grade_more_id" />
                            <field name="insentif_more" />
                            <field name="pencapaian_rekrutmen" widget='percentage' class='text-center' />
                            <field name="grade_rekrutmen_id" class='text-center'  groups='mum_kpi.group_insentif_manager'/>
                            <field name="insentif_rekrutmen"  groups='mum_kpi.group_insentif_manager'/>
                            <field name="pencapaian_maintain" widget='percentage' class='text-center' />
                            <field name="grade_maintain_id" class='text-center'  groups='mum_kpi.group_insentif_manager'/>
                            <field name="insentif_maintain"  groups='mum_kpi.group_insentif_manager'/>
                            <field name="pencapaian_tl" widget='percentage' class='text-center' />
                            <field name="grade_tl_id" class='text-center'  groups='mum_kpi.group_insentif_manager'/>
                            <field name="insentif_tl"  groups='mum_kpi.group_insentif_manager'/>
                            
                            
                            
                            <field name="pemenuhan" widget='percentage'  invisible='1'/>
                            <field name="employee_kro_kpi_id" invisible='1' />
                            <field name="month_id" invisible='1'/>
                            <field name="cabang" invisible='1' />
                            <field name="formasi" invisible='1' />
                            <field name="aktif" invisible='1' />
                            <field name="resign" invisible='1' />
                            <field name="rekrutmen" invisible='1' />
                            <field name="tl" invisible='1' />
                            <field name="kurang" invisible='1' />

                            
                            
                            <field name="company_id" invisible='1' />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Untuk Reporting -->

    
    <record id="reporting_summary_ro_view_tree" model="ir.ui.view">
        <field name="name">reporting_summary_ro.view.tree</field>
        <field name="model">employee.ro.kpi</field>
        <field name="arch" type="xml">
            <tree create='0' delete='0'>
                <field name="employee_id" readonly='1' />
                <field name="absen" />
                <field name="tidak_masuk" />
                <field name="more" />
                <field name="total_resign" invisible='1' />
                <field name="total_rekrutmen" />
                <field name="total_tl" />
                <field name="average" widget='percentage' groups='mum_kpi.group_insentif_manager' />
                <field name="grade_average_id" groups='mum_kpi.group_insentif_manager' />
                <field name="company_id" invisible='1' />
                <field name="insentif_maintain"/>
                <field name="insentif_rekrutmen"/>
                <field name="insentif_tl"/>
                <field name="wilayah_suffer_id" groups='mum_kpi.group_insentif_manager' />
                <field name="insentif_wilayah_suffer"/>
                <field name="total_insentif"/>
                <field name="employee_monthly_kpi_line" invisible='1' />
            </tree>
        </field>
    </record>

    <record id="reporting_bulanan_ro_view_tree" model="ir.ui.view">
        <field name="name">reporting_bulanan_ro.view.tree</field>
        <field name="model">employee.monthly.kpi.line</field>
        <field name="arch" type="xml">
            <tree edit='0' create='0' delete='0' default_order='employee_id'>
                <field name="sequence" invisible='1' />
                <field name="employee_id" />
                <field name="name" />                                
                <field name="employee_kro_kpi_id" invisible='1' />
                <field name="month_id" invisible='1'/>
                <field name="absen" />
                <field name="tidak_masuk" />
                <field name="grade_absen_id" invisible='1' />
                <field name="more" />
                <field name="grade_more_id" invisible='1' />
                <field name="cabang" />
                <field name="formasi" />
                <field name="aktif" />
                <field name="resign" invisible='1' />
                <field name="rekrutmen" />
                <field name="tl" />
                <field name="kurang" />

                <field name="grade_absen_id"/>
                <field name="potongan_absen"/>
                <field name="grade_more_id"/>
                <field name="insentif_more"/>
                <field name="pencapaian_rekrutmen" widget='percentage'/>
                <field name="grade_rekrutmen_id"/>
                <field name="pencapaian_maintain" widget='percentage'/>
                <field name="grade_maintain_id"/>
                <field name="pencapaian_tl" widget='percentage'/>
                <field name="grade_tl_id"/>
                <field name="insentif_maintain"/>
                <field name="insentif_rekrutmen"/>
                <field name="insentif_tl"/>
                <field name="pemenuhan"/>
                
                <field name="company_id" invisible='1' />
            </tree>
        </field>
    </record>
    
    <record id="action_reporting_summary_ro" model="ir.actions.act_window">
        <field name="name">Report Summary RO</field>
        <field name="res_model">employee.ro.kpi</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="reporting_summary_ro_view_tree"/>
    </record>
    
    <record id="action_reporting_bulanan_ro" model="ir.actions.act_window">
        <field name="name">Report Bulanan RO</field>
        <field name="res_model">employee.monthly.kpi.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="reporting_bulanan_ro_view_tree"/>
    </record>
    

</odoo>
