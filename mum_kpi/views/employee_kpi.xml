<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="employee_kpi_batch_view_tree" model="ir.ui.view">
            <field name="name">employee.kpi.batch.view.tree</field>
            <field name="model">employee.kpi.batch</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="periode_id" />
                    <field name="month_ids" widget='many2many_tags'/>
                    <field name="kro_id" />
                    <field name="company_id" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="employee_kpi_batch_view_form" model="ir.ui.view">
            <field name="name">employee.kpi.batch.view.form</field>
            <field name="model">employee.kpi.batch</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Confirm" name="button_confirm" states='draft' type="object" class="oe_highlight"/>
                        <button string="Random Vals" states='in_progress' name="auto_fill_random_values" type="object" class="oe_highlight" groups='base.group_system'/>
                        <button string="Submit" name="button_submit" states='in_progress' type="object" class="oe_highlight"/>
                        <button string="Approve 1" name="button_approve_1" type="object" class="oe_highlight" attrs="{'invisible' : ['|', ('show_approval_button', '=', False), ('state', '!=', 'approval_1')]}" />
                        <button string="Approve 2" name="button_done" type="object" class="oe_highlight" attrs="{'invisible' : ['|', ('show_approval_button', '=', False), ('state', '!=', 'approval_2')]}" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_show_details_ro" type="object" class="oe_stat_button" icon="fa-pencil">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="employee_kpi_line_count" widget="statinfo" nolabel="1" string="RO Count"/>
                                    </span>
                                    <span class="o_stat_text">Detail RO</span>
                                </div>
                            </button>

                            <button name="action_show_details_alw" type="object" class="oe_stat_button" icon="fa-pencil">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="employee_alw_kpi_line_count" widget="statinfo" nolabel="1" string="RO Count"/>
                                    </span>
                                    <span class="o_stat_text">Detail ALW</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly='1'/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="tgl_dibuat" attrs="{'readonly' : [('state', '!=', 'draft')]}" />
                                <field name="kro_id"  attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                            </group>
                            <group>
                                <field name="periode_id" attrs="{'readonly' : [('state', '!=', 'draft')]}" />
                                <field name="month_ids" widget='many2many_tags'  attrs="{'readonly' : [('state', '!=', 'draft')]}" />    
                                <field name="company_id" invisible='1' />
                                <field name="user_approval_1" invisible='1'/>
                                <field name="user_approval_2" invisible='1'/>
                                <field name="show_approval_button" invisible='1'/>
                            </group>
                        </group>
                        <notebook>
                            <page name="insentif_ro_employee_ids" string="Karyawan RO">
                                <field name="employee_kpi_line">
                                    <tree editable='bottom' create='0'>
                                        <field name="employee_id" readonly='1' />
                                        <field name="absen" />
                                        <field name="more" />
                                        <field name="total_resign" />
                                        <field name="total_rekrutmen" />
                                        <field name="total_tl" />
                                        <field name="average" widget='percentage' />
                                        <field name="grade_average_id" />
                                        <field name="company_id" invisible='1' />
                                        <field name="insentif_maintain" invisible='1'/>
                                        <field name="insentif_rekrutmen" invisible='1'/>
                                        <field name="insentif_tl" invisible='1'/>
                                        <field name="insentif_wilayah_suffer" invisible='1'/>
                                        
                                        <field name="wilayah_suffer_id" />
                                        <field name="total_insentif" invisible='1'/>
                                        <field name="employee_monthly_kpi_line" invisible='1' />
                                        <button name="action_show_details" type="object" icon="fa-list" width="0.1" title="Details"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="karyawan_alw_ids" string="Karyawan ALW">
                                <field name="employee_alw_kpi_line">
                                    <tree editable='bottom' create='0'>
                                        <field name="employee_id" readonly='1' />
                                        <field name="absen" />
                                        <field name="total_karyawan_terakhir" />
                                        <!-- <field name="total_aktif" /> -->
                                        <field name="total_resign" />
                                        <field name="total_perp_kontrak" />
                                        <field name="total_incomplete_data" />
                                        <field name="total_pkwt" />
                                        <field name="total_ppkwt" />
                                        <field name="total_kesalahan_resign" />
                                        <field name="average_alw" widget='percentage' />
                                        <field name="grade_average_id" />
                                        

                                        <button name="action_show_details" type="object" icon="fa-list" width="0.1" title="Details"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="karyawan_kro" string="Karyawan KRO" groups='mum_kpi.group_insentif_manager' attrs="{'invisible' : [('state', 'not in', ('approval_1', 'approval_2', 'done'))]}">
                                <group>
                                    <group string="RO">
                                        <field name="average_ro" widget='percentage' />
                                        <field name="grading_ro_id" />
                                        <field name="insentif_g_ro" />
                                    </group>
                                    <group string="ALW">
                                        <field name="average_alw" widget='percentage' />
                                        <field name="grading_alw_id" />
                                        <field name="insentif_g_alw" />
                                    </group>
                                    <group string="Total">
                                        <field name="total_insentif" />
                                        <field name="penyesuaian" />
                                        <field name="alasan_penyesuaian" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- <div class="o_attachment_preview"/> -->
					<div class="oe_chatter">
						<field name="message_follower_ids" groups="base.group_user"/>
						<field name="activity_ids"/>
						<field name="message_ids"/>
					</div>
                </form>
            </field>
        </record>

        <record id="employee_kpi_view_tree" model="ir.ui.view">
            <field name="name">employee.kpi.view.tree</field>
            <field name="model">employee.kpi</field>
            <field name="arch" type="xml">
                <tree create='0' delete='0'>
                    <field name="employee_id" readonly='1' />
                    <field name="absen" />
                    <field name="more" />
                    <field name="total_resign" />
                    <field name="total_rekrutmen" />
                    <field name="total_tl" />
                    <field name="average" widget='percentage' />
                    <field name="grade_average_id" />
                    <field name="company_id" invisible='1' />
                    <field name="insentif_maintain" invisible='1'/>
                    <field name="insentif_rekrutmen" invisible='1'/>
                    <field name="insentif_tl" invisible='1'/>
                    <field name="insentif_wilayah_suffer" invisible='1'/>
                    
                    <field name="wilayah_suffer_id" />
                    <field name="total_insentif" invisible='1'/>
                    <field name="employee_monthly_kpi_line" invisible='1' />
                </tree>
            </field>
        </record>

        <record id="employee_kpi_view_form" model="ir.ui.view">
            <field name="name">employee.kpi.view.form</field>
            <field name="model">employee.kpi</field>
            <field name="arch" type="xml">
                <form create='0' delete='0'>
                    <sheet>
                        <group string="Total">
                            <group>
                                <field name="total_resign" />
                                <field name="total_rekrutmen" />
                                <field name="total_tl" />
                                
                                <field name="employee_id" invisible='1' />
                                <field name="company_id" invisible='1' />
                                <field name="state" invisible='1' />
                                <field name="wilayah_suffer_id" attrs="{'readonly' : [('state', 'in', ('draft', 'done', 'cancel'))]}"/>
                            </group>
                            
                            <group>
                                <field name="avg_maintain_pertama" widget='percentage'  attrs="{'readonly' : [('state', 'in', ('draft', 'done', 'cancel'))]}" />
                                <field name="average" widget='percentage' />
                                <field name="grade_average_id" />
                            </group>
                        </group>
                        <group string="Insentif RO" groups='mum_kpi.group_insentif_manager' attrs="{'invisible' : [('state', 'not in', ('approval_1', 'approval_2', 'done'))]}">
                            <group>
                                <field name="insentif_wilayah_suffer" />
                                <field name="insentif_maintain" />
                                <field name="insentif_rekrutmen" />
                                <field name="insentif_tl" />
                                <field name="total_insentif" />
                            </group>
                            <group>
                                <field name="usulan_kabag" attrs="{'readonly' : [('state', 'in', ('draft', 'approval_2', 'done', 'cancel'))]}"/>
                                <field name="penyesuaian_kabag" />
                                <field name="alasan_penyesuaian" attrs="{'readonly' : [('state', 'in', ('draft', 'in_progress', 'done', 'cancel'))]}"/>
                                <field name="komite" attrs="{'readonly' : [('state', 'in', ('draft', 'in_progress', 'done', 'cancel'))]}"/>
                            </group>
                            
                            
                        </group>
                        <separator string="KPI Bulanan"/>
                        <field name="employee_monthly_kpi_line" attrs="{'readonly' : [('state', 'in', ('draft', 'approval_2', 'done', 'cancel'))]}">
                            <tree editable='bottom' delete='0' create='0'>
                                <field name="sequence" invisible='0' />
                                <field name="name" />                                
                                <field name="employee_kpi_batch_id" invisible='1' />
                                <field name="month_id" invisible='1'/>
                                <field name="absen" />
                                <field name="more" />
                                <field name="cabang" />
                                <field name="formasi" />
                                <field name="aktif" />
                                <field name="resign" />
                                <field name="rekrutmen" />
                                <field name="tl" />
                                <field name="kurang" />

                                <field name="pencapaian_rekrutmen" widget='percentage' invisible='1' />
                                <field name="grade_rekrutmen_id" invisible='1' />
                                <field name="pencapaian_maintain" widget='percentage' invisible='1' />
                                <field name="grade_maintain_id" invisible='1' />
                                <field name="pencapaian_tl" widget='percentage' invisible='1' />
                                <field name="grade_tl_id" invisible='1' />
                                <field name="insentif_maintain" invisible='1' />
                                <field name="insentif_rekrutmen" invisible='1' />
                                <field name="insentif_tl" invisible='1' />
                                <field name="pemenuhan" widget='percentage' />
                                
                                <field name="company_id" invisible='1' />
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="employee_alw_kpi_view_tree" model="ir.ui.view">
            <field name="name">employee.alw.kpi.view.tree</field>
            <field name="model">employee.alw.kpi</field>
            <field name="arch" type="xml">
                <tree delete='0' create='0'>
                    <field name="employee_id" readonly='1' />
                    <field name="absen" />
                    <field name="total_karyawan_terakhir" />
                    <!-- <field name="total_aktif" /> -->
                    <field name="total_resign" />
                    <field name="total_perp_kontrak" />
                    <field name="total_incomplete_data" />
                    <field name="total_pkwt" />
                    <field name="total_ppkwt" />
                    <field name="total_kesalahan_resign" />
                    <field name="average_alw" widget='percentage' />
                    <field name="grade_average_id" />
                    
                </tree>
            </field>
        </record>

        <record id="employee_alw_kpi_view_form" model="ir.ui.view">
            <field name="name">employee.alw.kpi.view.form</field>
            <field name="model">employee.alw.kpi</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Total">
                            <group>
                                <field name="total_karyawan_terakhir" />
                                <!-- <field name="total_aktif" /> -->
                                <field name="total_resign" />
                                <field name="total_perp_kontrak" />
                            </group>
                            <group>
                                <field name="total_incomplete_data" />
                                <field name="total_pkwt" />
                                <field name="total_ppkwt" />
                                <field name="total_kesalahan_resign" />
                                <field name="state" invisible='1'/>    
                            </group>
                        </group>
                        <group string='Persentase &amp; Grade'>
                            <group>
                                <field name="grade_incomplete_data_id"/>
                                <field name="persen_incomplete_data" widget="percentage" />
                                <field name="grade_kesalahan_resign_id"/>
                                <field name="persen_kesalahan_resign" widget="percentage" />
                            </group>
                            <group>
                                <field name="grade_pkwt_id"/>
                                <field name="persen_pkwt" widget="percentage" />
                                <field name="grade_ppkwt_id"/>
                                <field name="persen_ppkwt" widget="percentage" />

                                <field name="grade_average_id"/>
                                <field name="average_alw" widget="percentage" />
                                
                            </group>
                        </group>
                        <group string="Insentif ALW" groups='mum_kpi.group_insentif_manager' attrs="{'invisible' : [('state', 'not in', ('approval_1', 'approval_2', 'done'))]}">
                            <group>
                                <field name="insentif_alw_resign" />
                                <field name="insentif_alw_incomplete_data" />
                                <field name="insentif_alw_pkwt" />
                                <field name="insentif_alw_ppkwt" />
                                <field name="insentif_total" /> 
                            </group>
                            
                            <group>
                                <field name="usulan_kabag" />
                                <field name="penyesuaian_kabag" />
                                <field name="alasan_penyesuaian" />
                                <field name="komite" />
                            </group>
                            
                            
                        </group>
                        <separator string="Detail KPI ALW"/>
                        <field name="alw_monthly_kpi_line" attrs="{'readonly' : [('state', 'in', ('draft', 'approval_2', 'done', 'cancel'))]}">
                            <tree editable='bottom' create='0' delete='0'>
                                <field name="sequence" invisible='0' />
                                <field name="name" readonly='1'/>
                                <field name="absen" />
                                <field name="month_id" invisible='1' />
                                <field name="karyawan_terakhir" />
                                <!-- <field name="aktif" /> -->
                                <field name="resign" />
                                <field name="perp_kontrak" />
                                <field name="incomplete_data" />
                                <field name="pkwt" />
                                <field name="ppkwt" />
                                <field name="kesalahan_resign" />
                                <field name="persen_incomplete_data" invisible='1'/>
                                <field name="persen_pkwt" invisible='1'/>
                                <field name="persen_ppkwt" invisible='1'/>
                                <field name="persen_kesalahan_resign" invisible='1'/>
                                <field name="grade_incomplete_data_id" invisible='1'/>
                                <field name="grade_pkwt_id" invisible='1'/>
                                <field name="grade_ppkwt_id" invisible='1'/>
                                <field name="grade_kesalahan_resign_id" invisible='1'/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="employee_kpi_batch_view_search" model="ir.ui.view">
            <field name="name">employee.kpi.batch.view.search</field>
            <field name="model">employee.kpi.batch</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="kro_id" />
                </search>
            </field>
        </record>

        <record id="employee_kpi_batch_action" model="ir.actions.act_window">
            <field name="name">KPI Batch</field>
            <field name="res_model">employee.kpi.batch</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p>
                    Tidak Ada Data, silakan buat data baru.
                </p>
            </field>
        </record>
        
        
    </data>
</odoo>