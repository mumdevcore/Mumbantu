<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="employee_kpi_portofolio_view_tree" model="ir.ui.view">
        <field name="name">employee.portofolio.kpi.view.tree</field>
        <field name="model">employee.portofolio.kpi</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="tgl_dibuat" />
                <field name="tahun" />
                <field name="periode_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="employee_kpi_portofolio_view_form" model="ir.ui.view">
        <field name="name">employee.portofolio.kpi.view.form</field>
        <field name="model">employee.portofolio.kpi</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Confirm" name="button_confirm" states='draft' type="object" class="oe_highlight"/>
                    <!-- <button string="Random Vals" states='in_progress' name="auto_fill_random_values" type="object" class="oe_highlight" groups='base.group_system'/> -->
                    <button string="Submit" name="button_submit" states='in_progress' type="object" class="oe_highlight"/>
                    <field name="state" widget='statusbar' statusbar_visible='draft,done'/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- <button name="action_name" type="object" class="oe_stat_button" icon="fa-">
                            <field name="field_name" string="" widget="statinfo"/>
                        </button> -->
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly='1'/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="tgl_dibuat" />
                            <field name="tahun" />
                            <field name="employee_id" />
                            <field name="employee_manager_id" invisible='1'/>
                        </group>
                        <group>
                            <field name="kpi_sebelumnya_id" />
                            <field name="periode_id" />
                            <field name="month_ids" widget='many2many_tags' />
                        </group>
                    </group>

                    <notebook>
                        <page name="details" string="Details">
                            <field name="employee_portofolio_kpi_line">
                                <tree editable='bottom' create='0' delete='0'>
                                    <field name="employee_id" />
                                    <field name="total_kekurangan" />
                                    <field name="employee_kpi_line_sebelumnya_id" invisible='1' />
                                    <field name="grade_kekurangan_id" groups='mum_kpi.group_insentif_manager'/>
                                    <field name="insentif_kekurangan" groups='mum_kpi.group_insentif_manager'/>
                                    
                                    
                                            
                                    <field name="total_incomplete_data" />
                                    <field name="grade_incomplete_data_id" groups='mum_kpi.group_insentif_manager'/>
                                    <field name="insentif_incomplete_data" groups='mum_kpi.group_insentif_manager'/>
                                    
                                    <field name="total_sla" />
                                    <field name="grade_sla_id" groups='mum_kpi.group_insentif_manager'/>
                                    <field name="insentif_sla" groups='mum_kpi.group_insentif_manager'/>
    
                                    <field name="total_insentif" groups='mum_kpi.group_insentif_manager'/>
                                    <field name="insentif_periode_sebelumnya" groups='mum_kpi.group_insentif_manager'/>
                                    <field name="selisih" groups='mum_kpi.group_insentif_manager'/>
                                    <field name="alasan_penyesuaian" groups='mum_kpi.group_insentif_manager'/>
                                    <field name="penyesuaian" groups='mum_kpi.group_insentif_manager' string='Komite'/>
                                    <button name="action_show_details" type="object" icon="fa-list" width="0.1" title="Details"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="employee_portofolio_kpi_line_view_tree" model="ir.ui.view">
        <field name="name">employee.portofolio.kpi.line.view.tree</field>
        <field name="model">employee.portofolio.kpi.line</field>
        <field name="arch" type="xml">
            <tree create='false' delete='false'>
                <field name="employee_id" />
                <field name="total_kekurangan" />
                <field name="total_incomplete_data" />
                <field name="total_sla" />
            </tree>
        </field>
    </record>

    <record id="employee_portofolio_kpi_line_view_form" model="ir.ui.view">
        <field name="name">employee.portofolio.kpi.line.view.form</field>
        <field name="model">employee.portofolio.kpi.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string='Total'>
                            <field name="employee_id" invisible='1' />
                            <field name="total_kekurangan" />
                            <field name="total_incomplete_data" widget='percentage' />
                            <field name="total_sla" />
                            
                        </group>
                        <group string="Grade" groups='mum_kpi.group_insentif_manager'>
                            <field name="grade_kekurangan_id" />
                            <field name="grade_incomplete_data_id" />
                            <field name="grade_sla_id" />
                        </group>
                        <group string="Insentif" groups='mum_kpi.group_insentif_manager'>
                            <field name="total_insentif_more" />
                            <field name="total_potongan_absen" />
                            <field name="insentif_kekurangan" />
                            <field name="insentif_incomplete_data" />
                            <field name="insentif_sla" />
                            <field name="total_insentif" />
                            <field name="insentif_periode_sebelumnya" />
                            <field name="selisih" />
                        </group>
                        <group string="Penyesuaian" groups='mum_kpi.group_insentif_manager'>
                            <field name="penyesuaian" string='Komite' />
                            <field name="alasan_penyesuaian" />
                            <field name="company_id" invisible='1' />
                        </group>
                    </group>

                    <separator string="Details"/>
                    <field name="portofolio_monthly_line">
                        <tree editable='bottom' create='0' delete='0'>
                            <field name="name" />
                            <field name="month_id" invisible='1' />
                            <field name="absen" />
                            <field name="more" />
                            <field name="grade_absensi_id" groups='mum_kpi.group_insentif_manager' />
                            <field name="grade_more_id" groups='mum_kpi.group_insentif_manager' />
                            <field name="potongan_absen" groups='mum_kpi.group_insentif_manager' />
                            <field name="insentif_more" groups='mum_kpi.group_insentif_manager' />
                            <field name="kekurangan" />
                            <field name="incomplete_data" widget='percentage' />
                            <field name="sla" />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kpi_portofolio" model="ir.actions.act_window">
        <field name="name">KPI Portofolio</field>
        <field name="res_model">employee.portofolio.kpi</field>
        <field name="view_mode">tree,form</field>
    </record>
    

</odoo>
