<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- KPI Departemen/Bagian -->
    <record id="employee_manajemen_kpi_view_tree" model="ir.ui.view">
        <field name="name">employee.manajemen.kpi.view.tree</field>
        <field name="model">employee.manajemen.kpi</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="department_id" />
                <field name="employee_id" />
                <field name="periode_id" />
                <field name="tahun" />
                <field name="month_ids" widget='many2many_tags' />
                <field name="employee_parent_id" invisible='1' />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="employee_manajemen_kpi_view_form" model="ir.ui.view">
        <field name="name">employee.manajemen.kpi.view.form</field>
        <field name="model">employee.manajemen.kpi</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Submit" name="button_submit" type="object" class="oe_highlight" states='draft'/>
                    <button string="Cancel" name="button_cancel" type="object" states='draft,in_progress,approval_1'/>
                    <field name="state" widget='statusbar' statusbar_visible='draft,done' />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_show_ski" type="object" class="oe_stat_button" icon="fa-pencil">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="employee_kpi_count" widget="statinfo" nolabel="1" string="Karyawan"/>
                                </span>
                                <span class="o_stat_text">Detail Karyawan</span>
                            </div>
                        </button>
                    </div>
                    <div class='oe_title'>
                        <h1>
                            <field name="name" readonly='1' />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <!-- <field name="name" /> -->
                            <field name="tgl_dibuat" attrs="{'readonly' : [('state','!=','draft')]}" />
                            <field name="periode_id" required='1' attrs="{'readonly' : [('state','!=','draft')]}" />
                            <field name="month_ids" widget='many2many_tags' />
                            <field name="tahun" readonly='1'/>
                        </group>
                        <group>
                            <field name="employee_id" attrs="{'readonly' : [('state','!=','draft')]}" />
                            <field name="employee_parent_id" />
                            <field name="department_id"/>
                            <field name="company_id" invisible='1' />
                        </group>
                    </group>
                    <notebook>
                        <page name="kpi_employee" string="KPI Karyawan">
                            <field name="employee_manajemen_kpi_line_ids">
                                <tree editable='bottom' create='0' delete='0'>
                                    <field name="employee_id" />
                                    <field name="employee_job_id" />
                                    <field name="employee_parent_id" invisible='1' />
                                    <field name="kpi_manajemen_batch_id" invisible='1' />
                                    <field name="total_bobot" />
                                    <field name="nilai_pencapaian" />
                                    <field name="service" attrs="{'readonly' : [('parent.state', 'not in', ('draft','in_progress'))]}" />
                                    <field name="absen" attrs="{'readonly' : [('parent.state', 'not in', ('draft','in_progress'))]}" />
                                    <field name="total_pencapaian" />
                                    <field name="komite" groups="mum_kpi.group_kpi_manajemen_manager" />
                                    <field name="state" />
                                    <field name="detail_ids" invisible='1' />
                                    
                                    <button name="action_show_details" type="object" icon="fa-list" width="0.1" title="Details"/>
                                </tree>
                                
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_employee_manajemen_kpi" model="ir.actions.act_window">
        <field name="name">KPI Manajemen Bagian</field>
        <field name="res_model">employee.manajemen.kpi</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'shorten_department' : True}</field>
    </record>
    

</odoo>
