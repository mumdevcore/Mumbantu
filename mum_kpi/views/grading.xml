<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="grading_master_template_view_tree" model="ir.ui.view">
        <field name="name">grading.template.view.tree</field>
        <field name="model">grading.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="grade" />
                <field name="nilai_min" widget='percentage'/>
                <field name="nilai_max" widget='percentage'/>
            </tree>
        </field>
    </record>

    <record id="grading_master_template_view_form" model="ir.ui.view">
        <field name="name">grading.master.template.view.form</field>
        <field name="model">grading.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="grade"/>
                        </h1>
                    </div>
                    <separator string="Grading Global" style='font-size:2rem'/>
                    <group>
                        <group>
                            <label for="nilai_min_absen" string="Absensi"/>
							<div>
								<field name="nilai_min_absen" placeholder="From" class="oe_inline"/> 
								<div class='d-inline-block mx-5'>s/d</div>  
								<field name="nilai_max_absen" placeholder="To" class="oe_inline"/>
							</div>
                            <field name="potongan_absen" />
                        </group>
                        <group>
                            <label for="nilai_min_more" string="Kandidat di MORE"/>
							<div>
								<field name="nilai_min_more" placeholder="From" class="oe_inline"/> 
								<div class='d-inline-block mx-5'>s/d</div>  
								<field name="nilai_max_more" placeholder="To" class="oe_inline"/>
							</div>
                            <field name="insentif_more" />
                        </group>
                    </group>

                    <notebook>
                        <page name="mekaar" string="Mekaar">
                            <separator string="Grading RO" style='font-size:2rem'/>
                            <group>
                                <group>
                                    <label for="nilai_min_ro" string="Persentase RO"/>
                                    <div>
                                        <field name="nilai_min_ro" placeholder="From" widget="percentage" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_ro" placeholder="To" widget="percentage" class="oe_inline"/>
                                    </div>
                                </group>
                                <group>
                                    <field name="wilayah_suffer_id" />  
                                </group>
                                <group>
                                    <field name="insentif_rekrutmen" />
                                    <field name="insentif_maintain" />
                                    <field name="insentif_tl" />
                                </group>
                            </group>
        
                            <separator string='Grading ALW' style='font-size:2rem'/>
                            <group>
                                <group>
                                    <label for="nilai_min_alw_resign" string="Kesalahan Resign"/>
                                    <div>
                                        <field name="nilai_min_alw_resign" placeholder="From" widget="percentage" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_alw_resign" placeholder="To" widget="percentage" class="oe_inline"/>
                                    </div>
        
                                    <label for="nilai_min_alw_incomplete_data" string="Incomplete Data"/>
                                    <div>
                                        <field name="nilai_min_alw_incomplete_data" placeholder="From" widget="percentage" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div> 
                                        <field name="nilai_max_alw_incomplete_data" placeholder="To" widget="percentage" class="oe_inline"/>
                                    </div>
                                </group>
                                <group>
                                    <label for="nilai_min_alw_pkwt" string="PKWT"/>
                                    <div>
                                        <field name="nilai_min_alw_pkwt" placeholder="From" widget="percentage" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_alw_pkwt" placeholder="To" widget="percentage" class="oe_inline"/>
                                    </div>
        
                                    <label for="nilai_min_alw_ppkwt" string="PPKWT"/>
                                    <div>
                                        <field name="nilai_min_alw_ppkwt" placeholder="From" widget="percentage" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_alw_ppkwt" placeholder="To" widget="percentage" class="oe_inline"/>
                                    </div>
        
                                </group>
                                <group>
                                    <field name="insentif_alw_resign" />
                                    <field name="insentif_alw_incomplete_data" />
                                </group>
                                <group>
                                    <field name="insentif_alw_pkwt" />
                                    <field name="insentif_alw_ppkwt" />
                                </group>
                            </group>
        
                            <separator string='GRADING KRO' style='font-size:2rem'/>
                            <group>
                                <group string="RO">
                                    <label for="nilai_min_ro_avg" string="Persentase KRO"/>
                                    <div>
                                        <field name="nilai_min_ro_avg" placeholder="From" widget="percentage" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_ro_avg" placeholder="To" widget="percentage" class="oe_inline"/>
                                    </div>
                                    <field name="insentif_kro_ro" />
                                </group>
                                <group string="ALW">
                                    <label for="nilai_min_alw_avg" string="Average"/>
                                    <div>
                                        <field name="nilai_min_alw_avg" placeholder="From" widget="percentage" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_alw_avg" placeholder="To" widget="percentage" class="oe_inline"/>
                                    </div>
                                    <field name="insentif_kro_alw" />
                                </group>
                            </group>
                        </page>
                        <page name="portofolio" string="Portofolio">
                            <group>
                                <group>
                                    <label for="nilai_min_portofolio_kekurangan" string="Kekurangan"/>
                                    <div>
                                        <field name="nilai_min_portofolio_kekurangan" placeholder="From" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_portofolio_kekurangan" placeholder="To" class="oe_inline"/>
                                    </div>
                                    <field name="insentif_portofolio_kekurangan" />

                                    <label for="nilai_min_portofolio_incomplete_data" string="Incomplete Data"/>
                                    <div>
                                        <field name="nilai_min_portofolio_incomplete_data" placeholder="From" class="oe_inline" widget='percentage'/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_portofolio_incomplete_data" placeholder="To" class="oe_inline" widget='percentage'/>
                                    </div>
                                    <field name="insentif_portofolio_incomplete_data" />
                                </group>
                                <group>
                                    <label for="nilai_min_portofolio_sla" string="SLA"/>
                                    <div>
                                        <field name="nilai_min_portofolio_sla" placeholder="From" class="oe_inline"/> 
                                        <div class='d-inline-block mx-5'>s/d</div>  
                                        <field name="nilai_max_portofolio_sla" placeholder="To" class="oe_inline"/>
                                    </div>
                                    <field name="insentif_portofolio_sla" />                                    
                                </group>
                            </group>
                        </page>
                    </notebook>
                    
                    
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_grading_master_template" model="ir.actions.act_window">
        <field name="name">Template Grading</field>
        <field name="res_model">grading.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="monthly_grading_view_tree" model="ir.ui.view">
        <field name="name">monthly.grading.view.tree</field>
        <field name="model">monthly.grading</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="periode_id" />
                <field name="month_id" />
                <field name="tahun" />
            </tree>
        </field>
    </record>

    <record id="monthly_grading_view_form" model="ir.ui.view">
        <field name="name">monthly.grading.view.form</field>
        <field name="model">monthly.grading</field>
        <field name="arch" type="xml">
            <form create='0' edit='0'>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly='1'/>
                        </h1>
                    </div>
                    <group>
                        <field name="periode_id" />
                        <field name="month_id" />
                        <field name="tahun" />
                    </group>

                    <notebook>
                        <page name="employee_kpi_grading" string="KPI RO">
                            <field name="employee_monthly_kpi_line" readonly='1'>
                                <tree create='0' delete='0'>
                                    <!-- <field name="employee_monthly_kpi_line_id" invisible='1' /> -->
                                    <field name="employee_id" />
                                    <field name="absen" />
                                    <field name="grade_absen_id" />
                                    <field name="more" />
                                    <field name="grade_more_id" />
                                    <field name="pencapaian_rekrutmen" widget='percentage' />
                                    <field name="grade_rekrutmen_id" />
                                    <field name="pencapaian_maintain" widget='percentage' />
                                    <field name="grade_maintain_id" />
                                    <field name="pencapaian_tl" widget='percentage' />
                                    <field name="grade_tl_id" />
                                    <!-- <field name="pencapaian_average" widget='percentage' />
                                    <field name="grade_average_id" /> -->
                                </tree>
                            </field>
                        </page>
                        <page name='alw_kpi_grading' string="KPI ALW">
                            <field name="alw_monthly_kpi_line" readonly='1'>
                                <tree editable='bottom' create='0' delete='0'>
                                    <field name="employee_id"/>
                                    <field name="absen" />
                                    <field name="grade_absen_id" />
                                    <field name="persen_incomplete_data" widget='percentage'/>
                                    <field name="grade_incomplete_data_id"/>
                                    <field name="persen_pkwt" widget='percentage'/>
                                    <field name="grade_pkwt_id"/>
                                    <field name="persen_ppkwt" widget='percentage'/>
                                    <field name="grade_ppkwt_id"/>
                                    <field name="persen_kesalahan_resign" widget='percentage'/>
                                    <field name="grade_kesalahan_resign_id"/>
                                </tree>
                            </field>
                        </page>
                        <page name="resume_kpi_grading_ids" string="Resume KPI Grading">
                            <field name="resume_kpi_grading_ids" readonly='1'>
                                <tree>
                                    <field name="grade_template_id" invisible='1' />
                                    <field name="grade" />
                                    <field name="jumlah_ro" />
                                    <field name="jumlah_alw" />
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <record id="action_monthly_grading" model="ir.actions.act_window">
        <field name="name">Rekap Grading Bulanan</field>
        <field name="res_model">monthly.grading</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
    

</odoo>
