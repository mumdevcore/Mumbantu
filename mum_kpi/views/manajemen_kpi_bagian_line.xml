<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="employee_manajemen_kpi_line_view_tree" model="ir.ui.view">
        <field name="name">employee.manajemen.kpi.line.view.tree</field>
        <field name="model">employee.manajemen.kpi.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="kpi_manajemen_batch_id" invisible='1'/>
                <field name="employee_id" />
                <field name="employee_job_id" />
                <field name="employee_parent_id" invisible='1' />
                <field name="total_bobot" />
                <field name="nilai_pencapaian" />
                <field name="state" />
                <field name="detail_ids" invisible='1' />
            </tree>
        </field>
    </record>

    <record id="employee_manajemen_kpi_line_view_form" model="ir.ui.view">
        <field name="name">employee.manajemen.kpi.line.view.form</field>
        <field name="model">employee.manajemen.kpi.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" />
                            <field name="employee_job_id" />
                            <field name="employee_parent_id" />
                            <field name="employee_manajemen_kpi_id" invisible='1' />
                            <field name="kpi_manajemen_batch_id" invisible='1' />
                        </group>
                        <group>
                            <field name="total_bobot"/>
                            <field name="nilai_pencapaian"/>
                            <field name="state" />
                        </group>
                    </group>

                    <hr/>
                    <field name="detail_ids" attrs="{'readonly' : [('state','not in',('in_progress','approval_1'))]}">
                        <tree editable='bottom' create='0' delete='0'>
                            <field name="ski" readonly='1' />
                            <field name="kpi" readonly='1' />
                            <field name="bobot"/>
                            <field name="target" />
                            <field name="realisasi" />
                            <field name="pencapaian" widget='percentage' />
                            <field name="nilai_pencapaian" />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
