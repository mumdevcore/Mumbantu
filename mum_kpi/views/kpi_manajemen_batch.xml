<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- KPI Manajemen Batch -->
    <record id="kpi_manajemen_batch_view_tree" model="ir.ui.view">
        <field name="name">kpi.manajemen.batch.view.tree</field>
        <field name="model">kpi.manajemen.batch</field>
        <field name="arch" type="xml">
            <tree create='0' edit='0'>
                <field name="name" />
                <field name="periode_id" />
                <field name="month_ids" />
                <field name="tahun" />
            </tree>
        </field>
    </record>

    <record id="kpi_manajemen_view_form" model="ir.ui.view">
        <field name="name">kpi.manajemen.batch.view.form</field>
        <field name="model">kpi.manajemen.batch</field>
        <field name="arch" type="xml">
            <form create='0' edit='0'>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- <button name="action_name" type="object" class="oe_stat_button" icon="fa-">
                            <field name="field_name" string="" widget="statinfo"/>
                        </button> -->
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly='1'/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="periode_id" required='1' />
                            <field name="month_ids" widget='many2many_tags' />
                            <field name="tahun" />
                            
                        </group>
                    </group>
                    <notebook>
                        <page name="kpi_bagian" string="Bagian">
                            <field name="employee_manajemen_kpi_ids">
                                <tree>
                                    <field name="name" />
                                    <field name="department_id" />
                                    <field name="employee_id" string="Kabag" />
                                    <field name="month_ids" widget='many2many_tags' />
                                    <field name="periode_id" />
                                    <field name="tahun" />
                                    <field name="employee_parent_id" invisible='1' />
                                    <field name="state" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kpi_manajemen_batch" model="ir.actions.act_window">
        <field name="name">KPI Manajemen Batch</field>
        <field name="res_model">kpi.manajemen.batch</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'shorten_department' : True}</field>
    </record>
    
    <!-- KPI Batch Departemen/Bagian -->

</odoo>
