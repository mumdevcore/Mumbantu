<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="employee_kro_kpi_view_tree" model="ir.ui.view">
            <field name="name">employee.kro.kpi.view.tree</field>
            <field name="model">employee.kro.kpi</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="periode_id" />
                    <field name="month_ids" widget='many2many_tags'/>
                    <field name="employee_id" />
                    <field name="company_id" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="employee_kro_kpi_view_form" model="ir.ui.view">
            <field name="name">employee.kro.kpi.view.form</field>
            <field name="model">employee.kro.kpi</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Confirm" name="button_confirm" states='draft' type="object" class="oe_highlight"/>
                        <button string="Random Vals" states='in_progress' name="auto_fill_random_values" type="object" class="oe_highlight" groups='base.group_system'/>
                        <button string="Submit" name="button_submit" states='in_progress' type="object" class="oe_highlight"/>
                        <button string="In Progress" name="button_inprogress" type="object" class="oe_highlight" groups='base.group_system'/>
                        <button string="Approve 1" name="button_approve_1" type="object" class="oe_highlight" attrs="{'invisible' : ['|', ('show_approval_button', '=', False), ('state', '!=', 'approval_1')]}" />
                        <button string="Approve 2" name="button_done" type="object" class="oe_highlight" attrs="{'invisible' : ['|', ('show_approval_button', '=', False), ('state', '!=', 'approval_2')]}" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_show_details_ro" type="object" class="oe_stat_button" icon="fa-pencil">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="employee_kpi_line_count" widget="statinfo" nolabel="1" string="RO Count"/>
                                    </span>
                                    <span class="o_stat_text">Detail RO</span>
                                </div>
                            </button>

                            <button name="action_show_details_alw" type="object" class="oe_stat_button" icon="fa-pencil">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="employee_alw_kpi_line_count" widget="statinfo" nolabel="1" string="RO Count"/>
                                    </span>
                                    <span class="o_stat_text">Detail ALW</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly='1'/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="tgl_dibuat" attrs="{'readonly' : [('state', '!=', 'draft')]}" />
                                <field name="tahun" readonly='1' />
                                <field name="employee_id"  attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                                <field name="kpi_sebelumnya_id" invisible='1'  />
                            </group>
                            <group>
                                <field name="periode_id" attrs="{'readonly' : [('state', '!=', 'draft')]}" />
                                <field name="month_ids" widget='many2many_tags'  attrs="{'readonly' : [('state', '!=', 'draft')]}" />    
                                <field name="company_id" invisible='1' />
                                <field name="user_approval_1" invisible='1'/>
                                <field name="user_approval_2" invisible='1'/>
                                <field name="show_approval_button" invisible='1'/>
                                <field name="attachment_ids" widget='many2many_attachment_preview' />
                            </group>
                        </group>
                        <group>
                            <group string="Summary RO">
                                <field name="total_insentif_ro" />
                                <field name="total_insentif_sebelumnya_ro" />
                                <field name="total_penyesuaian_ro" />
                                
                            </group>
                            <group string="Summary ALW">
                                <field name="total_insentif_alw" />
                                <field name="total_insentif_sebelumnya_alw" />
                                <field name="total_penyesuaian_alw" />
                            </group>
                        </group>
                        <notebook>
                            <page name="insentif_ro_employee_ids" string="Karyawan RO">
                                <field name="employee_kpi_line">
                                    <tree editable='bottom' create='0'>
                                        <field name="employee_id" readonly='1' />
                                        <field name="employee_kpi_line_sebelumnya_id" invisible='1' />
                                        <field name="absen" />
                                        <field name="tidak_masuk" />
                                        <!-- <field name="grade_absen_id" invisible='1' /> -->
                                        <field name="more" />
                                        <!-- <field name="grade_more_id" invisible='1' /> -->
                                        <field name="total_resign" invisible='1' />
                                        <field name="total_rekrutmen" />
                                        <field name="total_tl" />
                                        <field name="average" widget='percentage' groups='mum_kpi.group_insentif_manager' />
                                        <field name="grade_average_id" groups='mum_kpi.group_insentif_manager' />
                                        <field name="company_id" invisible='1' />
                                        <field name="insentif_maintain" invisible='1'/>
                                        <field name="insentif_rekrutmen" invisible='1'/>
                                        <field name="insentif_tl" invisible='1'/>
                                        <field name="insentif_wilayah_suffer" invisible='1'/>
                                        
                                        <field name="wilayah_suffer_id"  groups='mum_kpi.group_insentif_manager'/>
                                        <field name="total_insentif"  groups='mum_kpi.group_insentif_manager'/>
                                        <field name="insentif_sebelumnya" />
                                        <field name="alasan_penyesuaian"  groups='mum_kpi.group_insentif_manager'/>
                                        <field name="penyesuaian"  groups='mum_kpi.group_insentif_manager'/>
                                        <field name="total_insentif" invisible='1' groups='mum_kpi.group_insentif_manager'/>
                                        <field name="employee_monthly_kpi_line" invisible='1' />
                                        <button name="action_show_details" type="object" icon="fa-list" width="0.1" title="Details"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="karyawan_alw_ids" string="Karyawan ALW">
                                <field name="employee_alw_kpi_line">
                                    <tree editable='bottom' create='0'>
                                        <field name="employee_id" />
                                        <field name="employee_kpi_line_sebelumnya_id" invisible='1' />
                                        <field name="absen" />
                                        <field name="tidak_masuk" />
                                        
                                        <field name="total_karyawan_terakhir" />
                                        <!-- <field name="total_aktif" /> -->
                                        <field name="total_resign" />
                                        <field name="total_perp_kontrak" />
                                        <field name="total_incomplete_data" />
                                        <field name="total_pkwt" />
                                        <field name="total_ppkwt" />
                                        <field name="total_kesalahan_resign" />
                                        <field name="average_alw" widget='percentage' groups='mum_kpi.group_insentif_manager' />
                                        <field name="grade_average_id" groups='mum_kpi.group_insentif_manager' />
                                        <field name="total_insentif" />
                                        <field name="insentif_sebelumnya" />
                                        <field name="alasan_penyesuaian"  groups='mum_kpi.group_insentif_manager'/>
                                        <field name="penyesuaian"  groups='mum_kpi.group_insentif_manager'/>

                                        <button name="action_show_details" type="object" icon="fa-list" width="0.1" title="Details"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="karyawan_kro" string="Karyawan KRO" groups='mum_kpi.group_insentif_manager' attrs="{'invisible' : [('state', 'not in', ('approval_1', 'approval_2', 'done'))]}">
                                <group>
                                    <group string="RO">
                                        <field name="average_ro" widget='percentage' attrs="{'readonly' : [('state','not in', ('draft','in_progress'))]}" />
                                        <field name="grading_ro_id" attrs="{'readonly' : [('state','not in', ('draft','in_progress'))]}" />
                                        <field name="insentif_g_ro" attrs="{'readonly' : [('state','not in', ('draft','in_progress'))]}" />
                                    </group>
                                    <group string="ALW">
                                        <field name="average_alw" widget='percentage' attrs="{'readonly' : [('state','not in', ('draft','in_progress'))]}" />
                                        <field name="grading_alw_id" attrs="{'readonly' : [('state','not in', ('draft','in_progress'))]}" />
                                        <field name="insentif_g_alw" attrs="{'readonly' : [('state','not in', ('draft','in_progress'))]}" />
                                    </group>
                                    <group string="Individu">
                                        <field name="more" />
                                        <field name="absen" />
                                        <field name="tidak_masuk" />
                                        <field name="grade_absensi_id" attrs="{'readonly' : [('state','not in', ('draft','in_progress', 'approval_2'))]}" />
                                        <field name="potongan_absen" attrs="{'readonly' : [('state','not in', ('draft','in_progress', 'approval_2'))]}" />
                                    </group>
                                    <group string="Total">
                                        <field name="total_insentif" />
                                        <field name="penyesuaian" />
                                        <field name="alasan_penyesuaian" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- <div class="o_attachment_preview"/> -->
					<div class="oe_chatter">
						<field name="message_follower_ids" groups="base.group_user"/>
						<field name="activity_ids"/>
						<field name="message_ids"/>
					</div>
                </form>
            </field>
        </record>

        

        <record id="employee_kro_kpi_view_search" model="ir.ui.view">
            <field name="name">employee.kro.kpi.view.search</field>
            <field name="model">employee.kro.kpi</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="employee_id" />
                </search>
            </field>
        </record>

        <record id="employee_kro_kpi_action" model="ir.actions.act_window">
            <field name="name">KPI KRO</field>
            <field name="res_model">employee.kro.kpi</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p>
                    Tidak Ada Data, silakan buat data baru.
                </p>
            </field>
        </record>

        <!-- Untuk Reporting -->

        <record id="reporting_summary_kro_view_tree" model="ir.ui.view">
            <field name="name">reporting_summary_kro.view.tree</field>
            <field name="model">employee.kro.kpi</field>
            <field name="arch" type="xml">
                <tree create='0' edit='0' delete='0'>
                    <field name="employee_id" />
                    <field name="absen" />
                    <field name="more" />
                    <field name="tidak_masuk" />
                    <field name="average_ro" widget='percentage'/>
                    <field name="grading_ro_id"/>
                    <field name="insentif_g_ro"/>
                    <field name="average_alw" widget='percentage'/>
                    <field name="grading_alw_id"/>
                    <field name="insentif_g_alw"/>       
                    <field name="grade_absensi_id"/>
                    <field name="potongan_absen"/>
                    <field name="total_insentif" />
                    <field name="penyesuaian" />
                    <field name="alasan_penyesuaian" />                  
                </tree>
            </field>
        </record>

        <record id="action_reporting_summary_kro" model="ir.actions.act_window">
            <field name="name">Report Summary KRO</field>
            <field name="res_model">employee.kro.kpi</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="reporting_summary_kro_view_tree"/>
        </record>
        
        
        
    </data>
</odoo>