<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model='ir.ui.view' id='job_title_view_tree'>
            <field name='name'>job_title_view.tree</field>
            <field name='model'>job.title</field>
            <field name='arch' type='xml'>
                <tree string='description' editable='bottom'>
                    <field name='name'/>
                </tree>
            </field>
        </record>

        <record id="action_job_title" model="ir.actions.act_window">
            <field name="name">Job Title</field>
            <field name="res_model">job.title</field>
            <field name="view_mode">tree</field>
        </record>

        <record model='ir.ui.view' id='res_cabang_view_tree'>
            <field name='name'>res_cabang_view.tree</field>
            <field name='model'>res.cabang</field>
            <field name='arch' type='xml'>
                <tree string='Cabang' editable='bottom'>
                    <field name='name'/>
                    <field name="kota_id"/>
                </tree>
            </field>
        </record>

        <record id="action_res_cabang" model="ir.actions.act_window">
            <field name="name">Cabang</field>
            <field name="res_model">res.cabang</field>
            <field name="view_mode">tree</field>
        </record>

        <record model='ir.ui.view' id='res_agama_view_tree'>
            <field name='name'>res_agama_view.tree</field>
            <field name='model'>res.agama</field>
            <field name='arch' type='xml'>
                <tree string='description' editable='bottom'>
                    <field name='name'/>
                </tree>
            </field>
        </record>

        <record id="action_res_agama" model="ir.actions.act_window">
            <field name="name">Agama</field>
            <field name="res_model">res.agama</field>
            <field name="view_mode">tree</field>
        </record>
        
        <record model='ir.ui.view' id='status_pajak_view_tree'>
            <field name='name'>status_pajak_view.tree</field>
            <field name='model'>status.pajak</field>
            <field name='arch' type='xml'>
                <tree string='description' editable='bottom'>
                    <field name='name'/>
                </tree>
            </field>
        </record>

        <record id="action_status_pajak" model="ir.actions.act_window">
            <field name="name">Status Pajak</field>
            <field name="res_model">status.pajak</field>
            <field name="view_mode">tree</field>
        </record>

    	<record model='ir.ui.view' id='hr_training_view_tree'>
    	    <field name='name'>hr_training_view.tree</field>
    	    <field name='model'>hr.training</field>
    	    <field name='arch' type='xml'>
    	        <tree string='HR Training' editable='bottom'>
    	            <field name='name'/>
    	            <field name='company_id'/>
    	        </tree>
    	    </field>
    	</record>

    	<record id="action_hr_training" model="ir.actions.act_window">
    		<field name="name">Tema Training</field>
    		<field name="res_model">hr.training</field>
    		<field name="view_mode">tree</field>
    	</record>


    	<record model='ir.ui.view' id='eksternal_group_view_tree'>
    	    <field name='name'>eksternal_group_view.tree</field>
    	    <field name='model'>eksternal.group</field>
    	    <field name='arch' type='xml'>
    	        <tree string='description' editable='bottom'>
    	            <field name='name'/>
    	            <field name="company_id"/>
    	        </tree>
    	    </field>
    	</record>

    	<record id="action_eksternal_group" model="ir.actions.act_window">
    		<field name="name">Eksternal Group</field>
    		<field name="res_model">eksternal.group</field>
    		<field name="view_mode">tree</field>
    	</record>

    	<menuitem id="hr_training_menu" name="Tema Training" parent="configuration_menu" groups="hr.group_hr_user" action="action_hr_training" sequence='10'/>
    	<menuitem id="eksternal_group_menu" name="Eksternal Group" parent="configuration_menu" action="action_eksternal_group" sequence='20'/>
        <menuitem id="res_agama_menu" name="Agama" parent="hr.menu_human_resources_configuration" action="action_res_agama"/>
        <menuitem id="status_pajak_menu" name="Status Pajak" parent="hr.menu_human_resources_configuration" action="action_status_pajak"/>
        <menuitem id="res_cabang_menu" name="Cabang" parent="hr.menu_human_resources_configuration" action="action_res_cabang"/>
        <menuitem id="job_title_menu" name="Job Title" parent="hr.menu_human_resources_configuration" action="action_job_title"/>
    </data>
</odoo>
