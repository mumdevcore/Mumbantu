<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_res_partner_kelurahan_form" model="ir.ui.view">
            <field name="name">res.partner.kelurahan.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <field name="city" position="after">
                    <field name="kota_id" placeholder='Kota/Kabupaten' />
                    <field name="kecamatan_id" placeholder='Kecamatan'/>
                    <field name="kelurahan_id" placeholder='Kelurahan'/>
                </field>
            </field>
        </record>

    </data>
</odoo>