<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_kota_tree" model="ir.ui.view">
            <field name="name">kota.tree</field>
            <field name="model">vit.kota</field>
            <field name="type">tree</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <tree string="Kota/Kab">
                    <field name="name"/>
                    <field name="state_id"/>
                </tree>
            </field>
        </record>

        <record id="view_kota_form" model="ir.ui.view">
            <field name="name">kota.form</field>
            <field name="model">vit.kota</field>
            <field name="type">form</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Kota/Kab" version="7.0">
                    <group colspan="4">
                        <field name="name"/>
                        <field name="state_id"/>
                    </group>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_kota_view">
            <field name="name">Kota/Kab</field>
            <field name="res_model">vit.kota</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_kota" name="Kota/Kabupaten" parent="contacts.menu_localisation" action="act_open_kota_view"/>

    </data>
</odoo>