<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_anggaran">
        <field name="name">Budgeting</field>
        <field name="visible" eval="1" />
    </record>

    <record id="group_budget_user" model="res.groups">
        <field name="name">Budget User</field>
        <field name="category_id" ref="mum_budget.module_category_anggaran"/>
    </record>

    <record id="group_budget_accounting" model="res.groups">
        <field name="name">Accounting</field>
        <field name="implied_ids"
               eval="[(4, ref('mum_budget.group_budget_user'))]"/>
        <field name="category_id" ref="mum_budget.module_category_anggaran"/>
    </record>

    <record id="group_budget_trops" model="res.groups">
        <field name="name">Trops</field>
        <field name="implied_ids"
               eval="[(4, ref('mum_budget.group_budget_accounting'))]"/>
        <field name="category_id" ref="mum_budget.module_category_anggaran"/>
    </record>

    <record id="group_budget_anggaran" model="res.groups">
        <field name="name">Anggaran</field>
        <field name="implied_ids"
               eval="[(4, ref('mum_budget.group_budget_accounting'))]"/>
        <field name="category_id" ref="mum_budget.module_category_anggaran"/>
    </record>

    <record id="group_budget_kabag" model="res.groups">
        <field name="name">Kabag</field>
        <field name="implied_ids"
               eval="[
               (4, ref('mum_budget.group_budget_trops')),
               (4, ref('mum_budget.group_budget_anggaran'))]"/>
        <field name="category_id" ref="mum_budget.module_category_anggaran"/>
    </record>

    <record id="group_budget_kadiv" model="res.groups">
        <field name="name">Kadiv</field>
        <field name="implied_ids"
               eval="[(4, ref('mum_budget.group_budget_kabag')),]"/>
        <field name="category_id" ref="mum_budget.module_category_anggaran"/>
    </record>

    <record id="group_budget_dirut" model="res.groups">
        <field name="name">Dirut</field>
        <field name="implied_ids"
               eval="[(4, ref('mum_budget.group_budget_kadiv'))]"/>
        <field name="category_id" ref="mum_budget.module_category_anggaran"/>
    </record>

    <record id="group_budget_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids"
               eval="[(4, ref('mum_budget.group_budget_dirut'))]"/>
        <field name="category_id" ref="mum_budget.module_category_anggaran"/>
    </record>

</odoo>
