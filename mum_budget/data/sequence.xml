<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="anggaran_divisi_bulanan_sequence" model='ir.sequence'>
        <field name='name'>Sequence Anggaran Divisi Bulanan</field>
        <field name="code">anggaran.divisi.bulanan.seq</field>
        <field name='suffix'>/%(range_year)s/%(range_month)s/MUM-DIV-BUDGET</field>
        <field name='padding'>3</field>
        <field eval="1" name="number_next"/>
        <field eval="1" name="number_increment"/>
        <field name='use_date_range' eval='True'/>
        <field name='range_reset'>monthly</field>
    </record>

