<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crossovered_budget_view_form" model="ir.ui.view">
        <field name="name">crossovered.budget.view.form</field>
        <field name="model">crossovered.budget</field>
        <field name="inherit_id" ref="om_account_budget.crossovered_budget_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <group string="Informasi Anggaran Keuangan">
                    <group>
                        <field name="planned_amount" />
                        <field name="currency_id" invisible='1' />
                    </group>
                    <group>
                        <field name="practical_amount" />
                    </group>
                </group>
                <!-- Dikomen karena pertimbangan apakah dibutuhkan atau tidak -->
                <!-- <group string="Informasi Anggaran Divisi">
                    <group>
                        <field name="planned_amount" />
                        <field name="currency_id" invisible='1' />
                    </group>
                    <group>
                        <field name="practical_amount" />
                    </group>
                </group> -->
            </xpath>
            <xpath expr="//notebook" position="inside">
                <!-- Anggaran Tahunan Divisi -->
                <page name='anggaran_divisi' string='Anggaran Divisi'>
                    <field name="anggaran_divisi_ids" readonly='1'>
                        <tree>
                            <field name="name" />
                            <field name="divisi_id" />
                            <!-- <field name="month_id" /> -->
                            <field name="tahun" />
                            <field name="planned_amount" />
                            <field name="practical_amount" />
                            <field name="company_id" />
                        </tree>
                    </field>
                </page>

                <page name='anggaran_divisi_bulanan' string='Anggaran Divisi Bulanan'>
                    <field name="anggaran_bulanan_divisi_ids" readonly='1'>
                        <tree>
                            <field name="name" />
                            <field name="divisi_id" />
                            <field name="month_id" />
                            <field name="tahun" />
                            <field name="company_id" />
                            <field name="total_anggaran" />
                            <field name="pengajuan_anggaran" />
                            <field name="realisasi_anggaran" />
                            <field name="sisa_anggaran" />
                            <field name="state" />
                        </tree>
                    </field>
                </page>

                
            </xpath>
            <xpath expr="//notebook/page[1]" position="before">
                <!-- <field name="currency_id" /> -->
                <page name='budget_parents' string='Budget Parent'>
                    <field name="budget_parent_ids">
                        <tree editable='bottom' create='1' edit='1'>
                            <field name="general_budget_id" />
                            <field name="name" />
                            <field name="planned_amount" />
                            <field name="practical_amount" />
                            <field name="theoritical_amount" />
                            <field name="percentage" />
                            <!-- <field name="crossovered_budget_id" />
                            <field name="crossovered_budget_child_ids" /> -->
                            <field name="currency_id" invisible='1' />
                            <field name="company_id" invisible='1' />
                            <field name="crossovered_budget_child_ids" invisible='1' />
                            <button name="action_show_details" type="object" icon="fa-list" width="0.1" title="Details"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
