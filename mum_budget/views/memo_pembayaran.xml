<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="memo_pembayaran_view_tree" model="ir.ui.view">
        <field name="name">memo.pembayaran.view.tree</field>
        <field name="model">memo.pembayaran</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="tanggal" />
                <field name="to_employee_id" />
                <field name="from_employee_id" />
                <field name="perihal" />
                <field name="keterangan" />
                <field name="journal_id" />
                <field name="tgl_saldo" />
                <field name="saldo_bank" />
                <field name="currency_id" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="memo_pembayaran_view_form" model="ir.ui.view">
        <field name="name">memo.pembayaran.view.form</field>
        <field name="model">memo.pembayaran</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Submit" name="button_submit" states='draft' type="object" class="oe_highlight" groups="mum_budget.group_budget_trops"/>
                    <button string="To Anggaran" name="button_to_anggaran" states='trops' type="object" class="oe_highlight" groups="mum_budget.group_budget_trops"/>
                    <button string="To Kabag" name="button_to_kabag" states='anggaran' type="object" class="oe_highlight" groups="mum_budget.group_budget_anggaran"/>
                    <button string="To Kadiv" name="button_to_kadiv" states='kabag' type="object" class="oe_highlight" groups="mum_budget.group_budget_kabag"/>
                    <button string="TO Dirut" name="button_to_dirut" type="object" attrs="{'invisible' : ['|', ('melebihi_limit', '=', False), ('state', '!=', 'kadiv')]}" class="oe_highlight" groups="mum_budget.group_budget_kadiv"/>
                    <button string="Approve" name="button_waiting" type="object" attrs="{'invisible' : ['|', ('melebihi_limit', '=', True), ('state', '!=', 'kadiv')]}" class="oe_highlight" groups="mum_budget.group_budget_kadiv"/>
                    <button string="Approve" name="button_waiting" states='dirut' type="object" class="oe_highlight" groups="mum_budget.group_budget_dirut"/>
                    <button string="Validate" name="button_done" type="object" states='waiting' class="oe_highlight" groups="mum_budget.group_budget_trops"/>
                    <button string="Cancel" name="button_cancel" type="object" attrs="{'invisible' : [('state', 'in', ('done', 'cancel'))]}"/>
                    <button string="Reset To Draft" name="button_draft" type="object" attrs="{'invisible' : [('state', '!=', 'cancel')]}"/>
                    <field name="melebihi_limit" invisible='1' />
                    <field name='state' widget='statusbar' statusbar_visible='draft,done'/>
                </header>
                <sheet>
                    <label for='name' string='Nomor'/>
                    <div class='oe_title'>
                        <h1>
                            <field name='name' readonly='1'/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tanggal" attrs="{'readonly' : [('state', '!=', 'draft')]}" />
                            <field name="to_employee_id" attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                            <field name="from_employee_id" attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                            <field name="perihal" attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                        </group>
                        <group>
                            <field name="keterangan" attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                            <field name="journal_id" attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                            <field name="tgl_saldo" attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                            <field name="saldo_bank" attrs="{'readonly' : [('state', '!=', 'draft')]}"/>
                            <field name="currency_id" invisible='1' />
                            <field name="company_id" invisible='1' />
                        </group>
                        <group>
                            <field name="trops_employee_id" readonly='1' invisible='1' />
                            <field name="anggaran_employee_id" readonly='1' invisible='1' />
                            <field name="kabag_employee_id" readonly='1' invisible='1' />
                            <field name="kadiv_employee_id" readonly='1' invisible='1' />
                            <field name="dirut_employee_id" readonly='1' invisible='1' />
                        </group>
                    </group>

                    <notebook>
                        <page string='Invoice'>
                            <field name="invoice_ids" readonly='1'>
                                <tree>
                                    <field name='name' string='Nomor'/>
                                    <field name="invoice_date" string='Bill Date' />
                                    <field name="narration" string='Keterangan' />
                                    <field name='amount_total'/>
                                    <field name="bukti_transfer_attachment_ids" widget='many2many_attachment_preview' />
                                    <field name="trops_selection" />
                                </tree>
                            </field>

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_memo_pembayaran" model="ir.actions.act_window">
        <field name="name">Memo Pembayaran</field>
        <field name="res_model">memo.pembayaran</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_memo_pembayaran_invoice_xlsx" model="ir.actions.report">
        <field name="name">Export Xlsx</field>
        <field name="model">memo.pembayaran</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">mum_budget.memo_pembayaran_invoice_xlsx</field>
        <field name="report_file">mum_budget.memo_pembayaran_invoice_xlsx</field>
        <field name="binding_model_id" ref="mum_budget.model_memo_pembayaran"/>
        <field name="binding_type">report</field>
    </record>
    

</odoo>
