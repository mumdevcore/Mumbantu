<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="program_kerja_view_tree" model="ir.ui.view">
        <field name="name">mum.program.kerja.view.tree</field>
        <field name="model">mum.program.kerja</field>
        <field name="arch" type="xml">
            <tree editable='bottom'>
                <field name="name" />
                <field name="divisi_id" />
            </tree>
        </field>
    </record>

    <record id="action_program_kerja" model="ir.actions.act_window">
        <field name="name">Program Kerja</field>
        <field name="res_model">mum.program.kerja</field>
        <field name="view_mode">tree</field>
    </record>
    

</odoo>
