<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pengajuan_anggaran_view_tree" model="ir.ui.view">
        <field name="name">pengajuan.anggaran.view.tree</field>
        <field name="model">pengajuan.anggaran</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="employee_id" />
                <field name="tanggal_pengajuan" />
                <field name="anggaran_divisi_id" />
                <field name="product_id" />
                <field name="tanggal_pertanggungjawaban" />
                <field name="divisi_id" />
                <field name="bagian_id" />
                <field name="tax_ids" />
                <field name="nilai_pengajuan" />
                <field name="nilai_realisasi" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="pengajuan_anggaran_view_form" model="ir.ui.view">
        <field name="name">pengajuan.anggaran.view.form</field>
        <field name="model">pengajuan.anggaran</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- <button string="Open" name="button_open" states='draft' type="object" class="oe_highlight"/> -->
                    <!-- <button string="Close" name="button_close" states='open' type="object" class="oe_highlight"/> -->
                    <!-- <button string="Re-Open" name="button_reopen" states='done' type="object"/> -->
                    <field name="state" widget='statusbar' statusbar_visible='draft,done' />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- <button name="action_show_details_ro" type="object" class="oe_stat_button" icon="fa-pencil">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="employee_kpi_line_count" widget="statinfo" nolabel="1" string="RO Count"/>
                                </span>
                                <span class="o_stat_text">Detail RO</span>
                            </div>
                        </button> -->
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly='1'/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="anggaran_divisi_id" domain="[('state','=','open')]" />
                            <field name="employee_id" />
                            <field name="bagian_id" />
                            <field name="divisi_id" />
                            <field name="tanggal_pengajuan" />
                            <field name="tanggal_pertanggungjawaban" />
                            
                        </group>
                        <group>
                            <field name="product_id" />
                            <field name="tax_ids" widget='many2many_tags' />
                            <field name="nilai_pengajuan" />
                            <field name="nilai_realisasi" />

                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_pengajuan_anggaran" model="ir.actions.act_window">
        <field name="name">Pengajuan Anggaran</field>
        <field name="res_model">pengajuan.anggaran</field>
        <field name="view_mode">tree,form</field>
    </record>
    

</odoo>
